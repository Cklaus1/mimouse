<?xml version="1.0" encoding="utf-8"?>
<!-- for packaging: /usr/lib/firewalld/services/mimouse.xml -->
<!-- configure manually: /etc/firewalld/services/mimouse.xml -->
<service>
  <short>MiMouse</short>
  <description>mouse and keyboard sharing via LAN</description>
  <port port="4242" protocol="udp"/>
  <!-- clipboard sharing (optional, `clipboard = true`) -->
  <port port="4242" protocol="tcp"/>
</service>
